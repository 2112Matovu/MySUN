# Supabase project settings — from Project Settings > API in your Supabase
# dashboard. Naming note: older Supabase projects call these "anon" and
# "service_role" keys; newer projects call them "publishable" and "secret"
# keys (sb_publishable_... / sb_secret_...) — either naming works here,
# just put the client-safe one in SUPABASE_ANON_KEY and the privileged
# server-only one in SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

APP_ENV=development
# Comma-separated. Add your deployed Flutter web origin too once you have one.
CORS_ORIGINS=http://localhost:5000,http://localhost:8080
